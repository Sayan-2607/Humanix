# All settings are optional; defaults shown.
PORT=8080
# Comma-separated list, or * for any origin (the API uses no cookies/credentials).
ALLOWED_ORIGINS=*
MAX_TEXT_CHARS=100000
# Vercel limits request bodies to 4.5 MB; keep uploads below that.
MAX_UPLOAD_BYTES=4194304
# Per client IP, per server instance.
RATE_LIMIT_RPM=120
# Contact email sent to Crossref for its "polite" pool (recommended).
CROSSREF_MAILTO=
CROSSREF_ENABLED=true
